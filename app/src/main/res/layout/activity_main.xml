<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:keepScreenOn="true">

    <!-- Video Oynatıcı Alanı -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- Ses Dosyası Çalarken Gösterilen Minimalist Arka Plan -->
    <TextView
        android:id="@+id/tvAudioOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:padding="20dp"
        android:text="🎵 Ses Dosyası Oynatılıyor"
        android:textColor="#E0E0E0"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Üst Fermata Tarzı Minimalist Kontrol Barı -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="top"
        android:background="#E61E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnToggleSidebar"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#2C2C2C"
            android:text="☰ Klasörler"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="Fermata Style - Hazır"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:backgroundTint="#2C2C2C"
            android:text="⏮"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#2C2C2C"
            android:text="⏭"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAspect"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2C2C2C"
            android:text="📐 Sığdır"
            android:textAllCaps="false"
            android:textColor="#4CAF50"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAutoBoot"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1B5E20"
            android:text="🚗 Oto-Başlat: AÇIK"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sol Yan Panel (Fermata Birebir Klasör ve Çalma Listesi Görünümü) -->
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:background="#F2181818"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTabPlaylist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="🎵 Çalma Listesi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTabBrowser"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1F1F1F"
                android:text="📁 USB / Dosyalar"
                android:textAllCaps="false"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActionLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#2C2C2C"
                android:text="➕ Klasördekileri Ekle"
                android:textAllCaps="false"
                android:textColor="#64B5F6"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnActionRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#4E1515"
                android:text="🗑️ Temizle"
                android:textAllCaps="false"
                android:textColor="#EF9A9A"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCurrentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:singleLine="true"
            android:text="/storage"
            android:textColor="#888888"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/listViewItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#282828"
            android:dividerHeight="1dp" />
    </LinearLayout>
</FrameLayout>
